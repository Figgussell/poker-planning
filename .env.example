# Server-only runtime login, a member of poker_app (not the database owner).
DATABASE_URL=postgresql://poker_runtime:replace-password@127.0.0.1:5432/poker_planning
# Migration owner; used only by npm run db:migrate, never by the app.
DATABASE_ADMIN_URL=postgresql://poker_owner:replace-password@127.0.0.1:5432/poker_planning
APP_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional disk-backed sandbox without PostgreSQL.
# LOCAL_DEMO_MODE=1 npm run dev
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
